# Copy to .env and fill in. .env is git-ignored and is never committed.
# No paid calls are made unless you explicitly run the runner with a real adapter.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional: point the OpenAI-compatible adapter at a local or hosted server
# (e.g. a vLLM server on a compute node). Leave unset for the OpenAI API.
# OPENAI_BASE_URL=http://localhost:8000/v1
